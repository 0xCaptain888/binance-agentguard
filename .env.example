# BSC TESTNET ONLY. No private key is required by the service.
# Use two independent HTTPS RPC providers. Never commit .env.
BSC_TESTNET_RPC_URL=
BSC_VERIFIER_RPC_URL=
BSC_VAULT_ADDRESS=
PORT=43188
DEPLOY_PORT=43191
# Optional public testnet host behind a dedicated HTTPS gateway.
# Local fixture mode rejects these public settings.
# BSC_PUBLIC_ORIGIN=https://agent.example.com
# BSC_LISTEN_HOST=127.0.0.1
# BSC_JOURNAL_PATH=.runtime/bsc-testnet-journal.json
# BSC_RECONCILE_INTERVAL_MS=30000
